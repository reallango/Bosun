    {
      "route": "POST setup/join-token",
      "reason": "browser-only auth flow"
    },
    {
      "route": "POST ws-token",
      "reason": "ws-token",
      "note": "A single-use WebSocket token; MCP clients cannot open Bosun's WebSocket."
    },
    {
      "route": "GET mcp",
      "reason": "mcp endpoint"
    },
    {
      "route": "POST mcp",
      "reason": "mcp endpoint"
    },
    {
      "route": "DELETE mcp",
      "reason": "mcp endpoint"
    },
    {
      "route": "GET mcp/info",
      "reason": "mcp endpoint"
    },
    {
      "route": "GET health",
      "reason": "covered by another tool",
      "note": "bosun_overview reports cluster health; system_health reports host health."
    },
    {
      "route": "GET openapi.json",
      "reason": "covered by another tool",
      "note": "The generated widget tools are built from the same specs."
    }
  ]
