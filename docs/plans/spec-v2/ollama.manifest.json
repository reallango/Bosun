{
  "schema": 1,
  "id": "ollama",
  "name": "Ollama Status",
  "version": "2.0.0",
  "description": "DRAFT of the self-contained Ollama package (spec version 2). A representative subset of its scripts: enough to prove the format; the full set is written when the widget is ported.",
  "author": "Bosun",
  "network": ["api.github.com"],
  "permissions": [
    { "id": "ollama.view", "label": "See Ollama", "description": "See the Ollama Status widget and the model list of a server.", "group": "Ollama", "defaultLevel": "viewer", "risk": "low", "scope": "server" },
    { "id": "ollama.models.pull", "label": "Pull Ollama models", "description": "Download models onto the host (and cancel a download).", "group": "Ollama", "defaultLevel": "operator", "risk": "medium", "scope": "server" },
    { "id": "ollama.models.delete", "label": "Delete Ollama models", "description": "Remove downloaded models from the host.", "group": "Ollama", "defaultLevel": "operator", "risk": "medium", "scope": "server" },
    { "id": "ollama.service", "label": "Install, update and control Ollama", "description": "Install Ollama on the host, update it, start and stop it, change its startup method, restart policy and settings.", "group": "Ollama", "defaultLevel": "admin", "risk": "high", "scope": "server" }
  ],
  "widgets": [
    {
      "type": "ollama_status",
      "display_name": "Ollama Status",
      "description": "Models, loaded models and their memory split; install, update and control Ollama",
      "icon": "bot",
      "category": "ai",
      "default_size": { "w": 8, "h": 8 },
      "min_size": { "w": 6, "h": 5 },
      "refresh_interval": 30,
      "supports_linux": true,
      "supports_windows": true,
      "spec": {
        "version": 2,
        "scripts": {
          "status": { "as": "service", "timeoutSec": 20, "linux": "scripts/status.sh", "windows": "scripts/status.ps1" },
          "detect": { "as": "service", "timeoutSec": 30, "linux": "scripts/detect.sh", "windows": "scripts/detect.ps1" },
          "win_control": {
            "as": "service", "timeoutSec": 120, "windows": "scripts/win_control.ps1",
            "params": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
              "op": { "type": "string", "values": ["start", "stop", "restart"] }
            }
          },
          "win_startup": {
            "as": "service", "timeoutSec": 60, "windows": "scripts/win_startup.ps1",
            "params": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
              "mode": { "type": "string", "values": ["auto", "delayed", "manual", "disabled"] }
            }
          },
          "win_setting": {
            "as": "service", "timeoutSec": 120, "windows": "scripts/win_setting.ps1",
            "params": {
              "manager": { "type": "string", "values": ["nssm", "windows"] },
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
              "setting": { "type": "string", "values": ["OLLAMA_CONTEXT_LENGTH", "OLLAMA_MAX_LOADED_MODELS"] },
              "value": { "type": "string", "pattern": "^[0-9]{0,9}$" }
            }
          },
          "win_install": {
            "as": "service", "timeoutSec": 3600, "windows": "scripts/win_install.ps1",
            "params": { "version": { "type": "string", "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})?$" } }
          },
          "win_update": {
            "as": "service", "timeoutSec": 3600, "windows": "scripts/win_update.ps1",
            "params": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
              "exe": { "type": "string", "pattern": "^[A-Za-z]:\\\\[A-Za-z0-9_. \\\\-]{1,160}ollama\\.exe$" },
              "version": { "type": "string", "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})?$" }
            }
          },
          "sd_control": {
            "as": "service", "timeoutSec": 120, "linux": "scripts/sd_control.sh",
            "params": {
              "unit": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
              "op": { "type": "string", "values": ["start", "stop", "restart"] }
            }
          },
          "sd_setting": {
            "as": "service", "timeoutSec": 120, "linux": "scripts/sd_setting.sh",
            "params": {
              "unit": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
              "setting": { "type": "string", "values": ["OLLAMA_CONTEXT_LENGTH", "OLLAMA_MAX_LOADED_MODELS"] },
              "value": { "type": "string", "pattern": "^[0-9]{0,9}$" }
            }
          },
          "dk_control": {
            "as": "service", "timeoutSec": 120, "linux": "scripts/dk_control.sh",
            "params": {
              "container": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$" },
              "op": { "type": "string", "values": ["start", "stop", "restart"] }
            }
          },
          "dk_policy": {
            "as": "service", "timeoutSec": 60, "linux": "scripts/dk_policy.sh",
            "params": {
              "container": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$" },
              "policy": { "type": "string", "values": ["no", "always", "unless-stopped", "on-failure"] }
            }
          },
          "dk_install": {
            "as": "service", "timeoutSec": 3600, "linux": "scripts/dk_install.sh",
            "params": { "version": { "type": "string", "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})?$" } }
          },
          "dk_update": {
            "as": "service", "timeoutSec": 3600, "linux": "scripts/dk_update.sh",
            "params": {
              "container": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$" },
              "version": { "type": "string", "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})?$" }
            }
          },
          "pull": {
            "as": "service", "timeoutSec": 3600, "linux": "scripts/pull.sh", "windows": "scripts/pull.ps1",
            "params": { "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._\\-/:]{0,199}$" } }
          },
          "delete": {
            "as": "service", "timeoutSec": 60, "linux": "scripts/delete.sh", "windows": "scripts/delete.ps1",
            "params": { "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._\\-/:]{0,199}$" } }
          }
        },
        "state": {
          "script": "detect",
          "periodSec": 60,
          "fields": {
            "install.kind": "string",
            "install.manager": "string",
            "install.name": "string",
            "install.state": "string",
            "install.start_mode": "string",
            "install.container": "string",
            "install.image": "string",
            "install.restart_policy": "string",
            "install.exe": "string",
            "install.docker_available": "boolean",
            "env.ollama_context_length": "string",
            "env.ollama_max_loaded_models": "string"
          }
        },
        "lookups": {
          "latest": { "url": "https://api.github.com/repos/ollama/ollama/releases/latest", "path": "tag_name", "match": "(\\d+\\.\\d+\\.\\d+)", "ttlSec": 21600 }
        },
        "data": { "source": "command", "script": "status", "parse": "json", "cacheSec": 15, "timeoutSec": 20, "permission": "ollama.view" },
        "metrics": [{ "name": "ollama.loaded", "label": "Loaded models", "from": { "agg": "count", "path": "ps.models" } }],
        "actions": [
          {
            "id": "start", "label": "Start", "icon": "play", "permission": "ollama.service", "kind": "script",
            "when": { "all": [{ "field": "state.install.kind", "in": ["service", "docker"] }, { "field": "state.install.state", "notEquals": "running" }] },
            "variants": [
              { "when": { "all": [{ "field": "state.install.kind", "equals": "service" }, { "field": "state.install.manager", "in": ["nssm", "windows"] }] }, "script": "win_control", "args": { "name": "state.install.name", "op": "literal:start" } },
              { "when": { "all": [{ "field": "state.install.kind", "equals": "service" }, { "field": "state.install.manager", "equals": "systemd" }] }, "script": "sd_control", "args": { "unit": "state.install.name", "op": "literal:start" } },
              { "when": { "field": "state.install.kind", "equals": "docker" }, "script": "dk_control", "args": { "container": "state.install.container", "op": "literal:start" } }
            ],
            "after": "refresh"
          },
          {
            "id": "stop", "label": "Stop", "icon": "square", "permission": "ollama.service", "kind": "script",
            "when": { "all": [{ "field": "state.install.kind", "in": ["service", "docker"] }, { "field": "state.install.state", "equals": "running" }] },
            "confirm": { "title": "Stop Ollama?", "text": "Models stop answering requests until it is started again.", "destructive": true },
            "variants": [
              { "when": { "all": [{ "field": "state.install.kind", "equals": "service" }, { "field": "state.install.manager", "in": ["nssm", "windows"] }] }, "script": "win_control", "args": { "name": "state.install.name", "op": "literal:stop" } },
              { "when": { "all": [{ "field": "state.install.kind", "equals": "service" }, { "field": "state.install.manager", "equals": "systemd" }] }, "script": "sd_control", "args": { "unit": "state.install.name", "op": "literal:stop" } },
              { "when": { "field": "state.install.kind", "equals": "docker" }, "script": "dk_control", "args": { "container": "state.install.container", "op": "literal:stop" } }
            ],
            "after": "refresh"
          },
          {
            "id": "set_startup", "label": "Startup method", "permission": "ollama.service", "kind": "script",
            "when": { "field": "state.install.kind", "equals": "service" },
            "params": { "mode": { "type": "string", "values": ["auto", "delayed", "manual", "disabled"] } },
            "variants": [
              { "when": { "field": "state.install.manager", "in": ["nssm", "windows"] }, "script": "win_startup", "args": { "name": "state.install.name", "mode": "param.mode" } }
            ],
            "after": "refresh"
          },
          {
            "id": "set_restart_policy", "label": "Restart policy", "permission": "ollama.service", "kind": "script",
            "when": { "field": "state.install.kind", "equals": "docker" },
            "params": { "policy": { "type": "string", "values": ["no", "always", "unless-stopped", "on-failure"] } },
            "variants": [{ "script": "dk_policy", "args": { "container": "state.install.container", "policy": "param.policy" } }],
            "after": "refresh"
          },
          {
            "id": "set_context_length", "label": "Context length", "permission": "ollama.service", "kind": "script",
            "when": { "field": "state.install.kind", "in": ["service", "docker"] },
            "params": { "value": { "type": "string", "pattern": "^[0-9]{0,9}$" } },
            "confirm": { "title": "Change the context length?", "text": "Ollama restarts to pick the setting up; loaded models are unloaded for a moment." },
            "variants": [
              { "when": { "field": "state.install.manager", "in": ["nssm", "windows"] }, "script": "win_setting", "args": { "manager": "state.install.manager", "name": "state.install.name", "setting": "literal:OLLAMA_CONTEXT_LENGTH", "value": "param.value" } },
              { "when": { "field": "state.install.manager", "equals": "systemd" }, "script": "sd_setting", "args": { "unit": "state.install.name", "setting": "literal:OLLAMA_CONTEXT_LENGTH", "value": "param.value" } }
            ],
            "after": "refresh"
          },
          {
            "id": "update", "label": "Update", "icon": "download", "permission": "ollama.service", "kind": "script", "job": true,
            "when": { "all": [{ "field": "lookups.latest", "newerThan": "data.version" }, { "field": "state.install.kind", "in": ["service", "docker"] }] },
            "confirm": { "title": "Update Ollama?", "text": "Ollama is unavailable while it is updated.", "destructive": true },
            "variants": [
              { "when": { "field": "state.install.kind", "equals": "docker" }, "script": "dk_update", "args": { "container": "state.install.container", "version": "lookups.latest" } },
              { "when": { "field": "state.install.manager", "in": ["nssm", "windows"] }, "script": "win_update", "args": { "name": "state.install.name", "exe": "state.install.exe", "version": "lookups.latest" } }
            ],
            "after": "refresh"
          },
          {
            "id": "install", "label": "Install", "icon": "download", "permission": "ollama.service", "kind": "script", "job": true,
            "when": { "field": "state.install.kind", "equals": "none" },
            "confirm": { "title": "Install Ollama?", "text": "Downloads Ollama and starts it as a service or container; it becomes reachable from your network on port 11434." },
            "variants": [
              { "when": { "field": "server.platform", "equals": "windows" }, "script": "win_install", "args": { "version": "literal:" } },
              { "when": { "field": "state.install.docker_available", "equals": true }, "script": "dk_install", "args": { "version": "literal:" } }
            ],
            "after": "refresh"
          },
          {
            "id": "pull", "label": "Pull", "icon": "download", "permission": "ollama.models.pull", "kind": "script", "job": true,
            "params": { "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._\\-/:]{0,199}$" } },
            "variants": [{ "script": "pull" }],
            "after": "refresh"
          },
          {
            "id": "delete", "label": "Delete", "icon": "trash-2", "permission": "ollama.models.delete", "kind": "script",
            "params": { "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._\\-/:]{0,199}$", "from": "name" } },
            "confirm": { "title": "Delete {name}?", "text": "This removes the model from the host. It has to be downloaded again to be used.", "destructive": true, "requireText": "{name}" },
            "variants": [{ "script": "delete" }],
            "after": "refresh"
          }
        ],
        "view": {
          "type": "layout",
          "blocks": [
            { "type": "kv", "items": [
              { "label": "Status", "value": "running", "format": "text", "when": { "field": "data.version", "exists": true } },
              { "label": "Status", "value": "not reachable", "format": "text", "when": { "field": "data.version", "exists": false } },
              { "label": "Version", "value": "{data.version}", "format": "text", "when": { "field": "data.version", "exists": true } }
            ] },
            {
              "type": "section", "title": "Installation", "defaultOpen": false,
              "summary": "{state.install.kind} {state.install.name}{state.install.container} {state.install.state}",
              "badges": [
                { "text": "Update available", "color": "blue", "when": { "field": "lookups.latest", "newerThan": "data.version" } },
                { "text": "Installing", "color": "amber", "when": { "field": "job.status", "equals": "running" } },
                { "text": "Not installed", "color": "gray", "when": { "field": "state.install.kind", "equals": "none" } }
              ],
              "blocks": [
                { "type": "notice", "level": "info", "text": "A standard install is not a service or container, so Bosun cannot manage it. Install Ollama as a service or container to manage it from here.", "when": { "field": "state.install.kind", "equals": "standard" } },
                { "type": "notice", "level": "warning", "text": "Docker is not installed (or not usable by the Bosun account), so the Docker install is not available.", "when": { "all": [{ "field": "state.install.kind", "equals": "none" }, { "field": "server.platform", "equals": "linux" }, { "field": "state.install.docker_available", "equals": false }] } },
                { "type": "buttons", "actions": ["start", "stop", "update", "install"] },
                { "type": "select", "label": "Startup", "value": "state.install.start_mode", "action": "set_startup", "param": "mode", "options": [
                  { "value": "auto", "label": "Automatic" }, { "value": "delayed", "label": "Automatic (delayed)" }, { "value": "manual", "label": "Manual" }, { "value": "disabled", "label": "Disabled" }
                ], "when": { "field": "state.install.kind", "equals": "service" } },
                { "type": "select", "label": "Restart policy", "value": "state.install.restart_policy", "action": "set_restart_policy", "param": "policy", "options": [
                  { "value": "no", "label": "Never" }, { "value": "always", "label": "Always" }, { "value": "unless-stopped", "label": "Unless stopped" }, { "value": "on-failure", "label": "On failure" }
                ], "when": { "field": "state.install.kind", "equals": "docker" } },
                { "type": "form", "title": "Context length", "fields": [
                  { "name": "value", "label": "OLLAMA_CONTEXT_LENGTH", "input": "number", "value": "state.env.ollama_context_length", "placeholder": "Ollama default", "help": "Tokens of context a model gets unless a request asks for another size." }
                ], "submit": { "action": "set_context_length", "label": "Apply", "params": { "value": "value" } }, "when": { "field": "state.install.kind", "in": ["service", "docker"] } },
                { "type": "jobProgress" }
              ]
            },
            { "type": "form", "title": "Pull a model", "fields": [{ "name": "model", "label": "Model", "input": "text", "placeholder": "llama3.2:1b" }],
              "submit": { "action": "pull", "label": "Pull", "params": { "model": "model" } }, "when": { "field": "data.version", "exists": true } },
            { "type": "view", "path": "tags.models", "view": {
              "type": "list", "empty": "No models installed",
              "row": { "title": "{name}", "subtitle": "{details.parameter_size} {details.quantization_level}", "fields": [{ "label": "Size", "value": "{size}", "format": "bytes" }], "actions": ["delete"] }
            } }
          ]
        }
      }
    }
  ]
}
