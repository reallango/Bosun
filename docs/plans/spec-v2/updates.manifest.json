{
  "schema": 1,
  "id": "updates",
  "name": "OS Update Check",
  "version": "2.0.0",
  "description": "DRAFT of the self-contained OS Update Check package (spec version 2): the update list is collected slowly by a script, installs run as jobs.",
  "author": "Bosun",
  "permissions": [
    { "id": "updates.view", "label": "See OS updates", "description": "See the OS Update Check widget and the pending updates of a server.", "group": "OS updates", "defaultLevel": "viewer", "risk": "low", "scope": "server" },
    { "id": "updates.check", "label": "Check for OS updates", "description": "Run an update check now and see the progress of an install.", "group": "OS updates", "defaultLevel": "operator", "risk": "low", "scope": "server" },
    { "id": "updates.install", "label": "Install OS updates", "description": "Install pending operating-system updates on the host.", "group": "OS updates", "defaultLevel": "operator", "risk": "high", "scope": "server", "implies": ["updates.check"] }
  ],
  "widgets": [
    {
      "type": "os_update_check",
      "display_name": "OS Update Check",
      "description": "Check for and install OS updates",
      "icon": "refresh-cw",
      "category": "system",
      "default_size": { "w": 8, "h": 5 },
      "min_size": { "w": 6, "h": 4 },
      "refresh_interval": 3600,
      "supports_linux": true,
      "supports_windows": true,
      "spec": {
        "version": 2,
        "scripts": {
          "list": { "as": "service", "timeoutSec": 600, "linux": "scripts/list.sh", "windows": "scripts/list.ps1" },
          "install": {
            "as": "service", "timeoutSec": 3600, "linux": "scripts/install.sh", "windows": "scripts/install.ps1",
            "params": { "security_only": { "type": "boolean", "default": false } }
          }
        },
        "data": { "source": "command", "script": "list", "parse": "json", "cacheSec": 21600, "timeoutSec": 600, "initialDelaySec": 300, "permission": "updates.view" },
        "actions": [
          {
            "id": "check", "label": "Check now", "icon": "refresh-cw", "permission": "updates.check", "kind": "script", "job": true, "stores": "data",
            "variants": [{ "script": "list" }],
            "after": "refresh"
          },
          {
            "id": "install", "label": "Install updates", "icon": "download", "permission": "updates.install", "kind": "script", "job": true,
            "when": { "field": "data.updatesAvailable", "gt": 0 },
            "params": { "security_only": { "type": "boolean", "default": false } },
            "confirm": { "title": "Install updates?", "text": "The packages listed are installed on the host. Services may restart and a reboot may be needed.", "destructive": true },
            "variants": [{ "script": "install", "args": { "security_only": "param.security_only" } }],
            "after": "refresh"
          }
        ],
        "view": {
          "type": "layout",
          "blocks": [
            { "type": "kv", "items": [
              { "label": "Package manager", "value": "{data.manager}", "format": "text" },
              { "label": "Updates available", "value": "{data.updatesAvailable}", "format": "text" },
              { "label": "Security updates", "value": "{data.securityUpdates}", "format": "text" }
            ] },
            { "type": "notice", "level": "warning", "text": "A reboot is required to finish earlier updates.", "when": { "field": "data.rebootRequired", "equals": true } },
            { "type": "buttons", "actions": ["check", "install"] },
            { "type": "jobProgress" },
            { "type": "view", "path": "packages", "view": {
              "type": "list", "empty": "Up to date",
              "row": { "title": "{name}", "subtitle": "{current_version} {new_version}", "badge": "{is_security}", "actions": [] }
            } }
          ]
        }
      }
    }
  ]
}
