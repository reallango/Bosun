{
  "schema": 1,
  "id": "docker",
  "name": "Docker Containers",
  "version": "0.1.1",
  "description": "Containers on the host with logs, a shell in each container, and start, stop and restart. Installed by default; the poller collects the container list.",
  "author": "Bosun",
  "permissions": [
    {
      "id": "docker.view",
      "label": "See containers",
      "description": "See the Docker containers widget and the container list of a server.",
      "group": "Docker",
      "defaultLevel": "viewer",
      "risk": "low",
      "scope": "server"
    },
    {
      "id": "docker.logs",
      "label": "View container logs",
      "description": "Read the recent log output of a container.",
      "group": "Docker",
      "defaultLevel": "operator",
      "risk": "low",
      "scope": "server"
    },
    {
      "id": "docker.containers.control",
      "label": "Start, stop and restart containers",
      "description": "Change the running state of containers on the host.",
      "group": "Docker",
      "defaultLevel": "operator",
      "risk": "medium",
      "scope": "server"
    },
    {
      "id": "docker.shell",
      "label": "Open a shell in a container",
      "description": "Show the shell button on each running container (the web terminal asks for your own login and is only available to Full access users), and let an API key with this permission get an API terminal in any container of the host (containers that could reach the host are refused).",
      "group": "Docker",
      "defaultLevel": "admin",
      "risk": "high",
      "scope": "server"
    }
  ],
  "widgets": [
    {
      "type": "docker_containers",
      "display_name": "Docker Containers",
      "description": "Containers on the host with logs and start, stop and restart.",
      "icon": "box",
      "category": "system",
      "default_size": { "w": 8, "h": 8 },
      "min_size": { "w": 5, "h": 5 },
      "refresh_interval": 15,
      "supports_linux": true,
      "supports_windows": false,
      "spec": {
        "version": 1,
        "data": {
          "source": "command",
          "as": "service",
          "command": "docker ps -a --format '{{json .}}'",
          "parse": "jsonlines",
          "cacheSec": 10,
          "timeoutSec": 20,
          "permission": "docker.view",
          "map": { "name": "Names", "image": "Image", "state": "State", "status": "Status", "ports": "Ports", "compose": "Labels" }
        },
        "metrics": [
          { "name": "docker.running", "label": "Running containers" }
        ],
        "view": {
          "type": "list",
          "empty": "No containers",
          "summary": [
            { "label": "running", "where": { "field": "state", "equals": "running" } },
            { "label": "total" }
          ],
          "filter": { "fields": ["name", "image"], "placeholder": "Filter" },
          "toggles": [
            { "key": "stopped", "label": "stopped", "default": true, "hideWhen": { "field": "state", "notEquals": "running" } }
          ],
          "row": {
            "dot": {
              "field": "state",
              "colors": { "running": "green", "restarting": "amber", "paused": "amber", "created": "gray", "exited": "gray", "dead": "red" }
            },
            "title": "{name}",
            "subtitle": "{image} · {status}",
            "actions": ["logs", "shell", "restart", "stop", "start"]
          }
        },
        "actions": [
          {
            "id": "logs",
            "label": "Logs",
            "icon": "scroll-text",
            "permission": "docker.logs",
            "as": "service",
            "command": "docker logs --tail {{lines}} {{name}} 2>&1",
            "params": {
              "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$", "from": "name" },
              "lines": { "type": "number", "min": 1, "max": 2000, "default": 300 }
            },
            "result": "text"
          },
          {
            "id": "shell",
            "label": "Shell",
            "icon": "terminal-square",
            "permission": "docker.shell",
            "terminal": { "container": "name" },
            "when": { "field": "state", "equals": "running" }
          },
          {
            "id": "restart",
            "label": "Restart",
            "icon": "rotate-cw",
            "permission": "docker.containers.control",
            "as": "service",
            "command": "docker restart {{name}}",
            "params": { "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$", "from": "name" } },
            "when": { "field": "state", "equals": "running" },
            "confirm": { "title": "Restart {name}?", "text": "Anything the container is serving will be interrupted.", "destructive": true },
            "after": "refresh"
          },
          {
            "id": "stop",
            "label": "Stop",
            "icon": "square",
            "permission": "docker.containers.control",
            "as": "service",
            "command": "docker stop {{name}}",
            "params": { "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$", "from": "name" } },
            "when": { "field": "state", "equals": "running" },
            "confirm": { "title": "Stop {name}?", "text": "Anything the container is serving will be interrupted.", "destructive": true },
            "after": "refresh"
          },
          {
            "id": "start",
            "label": "Start",
            "icon": "play",
            "permission": "docker.containers.control",
            "as": "service",
            "command": "docker start {{name}}",
            "params": { "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$", "from": "name" } },
            "when": { "field": "state", "notEquals": "running" },
            "after": "refresh"
          }
        ]
      }
    }
  ]
}
