{
  "schema": 1,
  "id": "system_services",
  "name": "System Services",
  "version": "1.2.2",
  "description": "System services with their status. Counts the running and failed ones, or shows the full list.",
  "author": "Bosun",
  "requires": {
    "api": 11
  },
  "permissions": [
    {
      "id": "system_services.view",
      "label": "See system services",
      "description": "See the System Services widget and the service list of a server.",
      "group": "System services",
      "defaultLevel": "viewer",
      "risk": "low",
      "scope": "server"
    }
  ],
  "widgets": [
    {
      "type": "system_services",
      "display_name": "System Services",
      "description": "System services with status",
      "icon": "settings",
      "category": "system",
      "default_size": {
        "w": 8,
        "h": 4
      },
      "min_size": {
        "w": 6,
        "h": 3
      },
      "refresh_interval": 30,
      "supports_linux": true,
      "supports_windows": true,
      "config_schema": [
        {
          "key": "filter",
          "label": "Show",
          "type": "select",
          "options": [
            "all",
            "running",
            "failed"
          ],
          "default": "all"
        }
      ],
      "spec": {
        "version": 2,
        "data": {
          "source": "snapshot",
          "section": "services",
          "permission": "system_services.view",
          "filter": [
            {
              "field": "status",
              "config": "filter",
              "all": "all",
              "default": "all"
            }
          ]
        },
        "metrics": [
          {
            "name": "system_services.running",
            "label": "Running services",
            "from": {
              "agg": "count",
              "where": {
                "field": "status",
                "equals": "running"
              }
            }
          },
          {
            "name": "system_services.failed",
            "label": "Failed services",
            "from": {
              "agg": "count",
              "where": {
                "field": "status",
                "equals": "failed"
              }
            }
          },
          {
            "name": "system_services.total",
            "label": "Services",
            "from": {
              "agg": "count"
            }
          }
        ],
        "looks": {
          "default": "tiles",
          "options": [
            {
              "id": "tiles",
              "label": "Tiles"
            },
            {
              "id": "list",
              "label": "List"
            }
          ]
        },
        "view": {
          "type": "layout",
          "blocks": [
            {
              "type": "stat",
              "when": {
                "field": "config.look",
                "equals": "tiles"
              },
              "items": [
                {
                  "label": "Running",
                  "count": {
                    "where": {
                      "field": "status",
                      "equals": "running"
                    }
                  },
                  "trend": {
                    "metric": "system_services.running",
                    "window": "24h"
                  },
                  "sub": "services"
                },
                {
                  "label": "Failed",
                  "count": {
                    "where": {
                      "field": "status",
                      "equals": "failed"
                    }
                  },
                  "trend": {
                    "metric": "system_services.failed",
                    "window": "24h"
                  },
                  "thresholds": {
                    "warning": 1,
                    "danger": 5
                  },
                  "sub": "need attention",
                  "when": {
                    "count": {
                      "path": "data",
                      "where": {
                        "field": "status",
                        "equals": "failed"
                      }
                    },
                    "gt": 0
                  },
                  "alternatives": [
                    {
                      "label": "Failed",
                      "value": "0",
                      "tone": "success",
                      "sub": "all healthy",
                      "when": {
                        "count": {
                          "path": "data"
                        },
                        "gt": 0
                      }
                    },
                    {
                      "label": "Failed",
                      "value": "—",
                      "sub": "no services",
                      "emphasis": "muted"
                    }
                  ]
                },
                {
                  "label": "Stopped",
                  "count": {
                    "where": {
                      "field": "status",
                      "equals": "stopped"
                    }
                  },
                  "emphasis": "muted",
                  "sub": "not running"
                }
              ],
              "columns": 3
            },
            {
              "type": "view",
              "when": {
                "field": "config.look",
                "equals": "list"
              },
              "view": {
                "type": "list",
                "empty": "No services",
                "summary": [
                  {
                    "label": "shown"
                  }
                ],
                "filter": {
                  "fields": [
                    "name",
                    "description"
                  ],
                  "placeholder": "Filter services"
                },
                "row": {
                  "dot": {
                    "field": "status",
                    "colors": {
                      "running": "green",
                      "failed": "red",
                      "stopped": "gray"
                    }
                  },
                  "title": "{name}",
                  "subtitle": "{description}",
                  "actions": []
                }
              }
            }
          ]
        }
      }
    }
  ]
}
