{
  "schema": 1,
  "id": "cpu_memory",
  "name": "CPU/Memory",
  "version": "1.2.0",
  "description": "CPU and memory usage with load averages, swap and temperature. Tracks CPU, load, temperature, memory and swap as history.",
  "author": "Bosun",
  "requires": {
    "api": 13
  },
  "permissions": [
    {
      "id": "cpu_memory.view",
      "label": "See CPU and memory",
      "description": "See the CPU/Memory widget and the CPU and memory data of a server.",
      "group": "CPU and memory",
      "defaultLevel": "viewer",
      "risk": "low",
      "scope": "server"
    }
  ],
  "widgets": [
    {
      "type": "cpu_memory",
      "display_name": "CPU/Memory",
      "description": "CPU and memory usage with load averages",
      "icon": "cpu",
      "category": "system",
      "default_size": {
        "w": 8,
        "h": 4
      },
      "min_size": {
        "w": 4,
        "h": 3
      },
      "refresh_interval": 5,
      "supports_linux": true,
      "supports_windows": true,
      "spec": {
        "version": 2,
        "looks": {
          "default": "tiles",
          "options": [
            {
              "id": "tiles",
              "label": "Tiles"
            },
            {
              "id": "gauges",
              "label": "Gauges"
            },
            {
              "id": "cores",
              "label": "Cores",
              "min_size": {
                "w": 8,
                "h": 6
              },
              "default_size": {
                "w": 10,
                "h": 6
              }
            }
          ]
        },
        "data": {
          "source": "snapshot",
          "section": "cpu_memory",
          "permission": "cpu_memory.view"
        },
        "metrics": [
          {
            "name": "cpu.usage",
            "label": "CPU usage",
            "unit": "%"
          },
          {
            "name": "cpu.load1",
            "label": "Load (1 min)"
          },
          {
            "name": "cpu.temp",
            "label": "CPU temperature",
            "unit": "°C"
          },
          {
            "name": "mem.used_pct",
            "label": "Memory used",
            "unit": "%"
          },
          {
            "name": "mem.used_mb",
            "label": "Memory used",
            "unit": "MB"
          },
          {
            "name": "swap.used_mb",
            "label": "Swap used",
            "unit": "MB"
          }
        ],
        "actions": [],
        "view": {
          "type": "layout",
          "blocks": [
            {
              "type": "stat",
              "when": {
                "field": "config.look",
                "equals": "tiles"
              },
              "items": [
                {
                  "label": "CPU",
                  "value": "{data.cpu.usagePercent}",
                  "unit": "%",
                  "bar": "{data.cpu.usagePercent}",
                  "trend": {
                    "metric": "cpu.usage",
                    "window": "1h"
                  },
                  "thresholds": {
                    "warning": 75,
                    "danger": 90
                  }
                },
                {
                  "label": "Memory",
                  "value": "{data.memory.usagePercent}",
                  "unit": "%",
                  "bar": "{data.memory.usagePercent}",
                  "trend": {
                    "metric": "mem.used_pct",
                    "window": "1h"
                  },
                  "thresholds": {
                    "warning": 75,
                    "danger": 90
                  }
                }
              ],
              "columns": 2
            },
            {
              "type": "gauges",
              "when": {
                "field": "config.look",
                "equals": "gauges"
              },
              "items": [
                {
                  "label": "CPU",
                  "value": "{data.cpu.usagePercent}",
                  "max": 100,
                  "unit": "%",
                  "thresholds": {
                    "warning": 75,
                    "danger": 90
                  }
                },
                {
                  "label": "Memory",
                  "value": "{data.memory.usagePercent}",
                  "max": 100,
                  "unit": "%",
                  "thresholds": {
                    "warning": 75,
                    "danger": 90
                  }
                }
              ],
              "columns": 2
            },
            {
              "type": "info",
              "when": {
                "field": "config.look",
                "equals": "cores"
              },
              "items": [
                {
                  "label": "CPU",
                  "value": "{data.cpu.usagePercent}",
                  "format": "percent"
                },
                {
                  "label": "Memory",
                  "value": "{data.memory.usagePercent}",
                  "format": "percent"
                },
                {
                  "label": "Cores",
                  "value": "{data.cpu.threads}"
                }
              ]
            },
            {
              "type": "meters",
              "when": {
                "field": "config.look",
                "equals": "cores"
              },
              "path": "cpu.cores",
              "shape": "bar",
              "layout": "grid",
              "empty": "No per-core data",
              "item": {
                "label": "{id}",
                "value": "{usagePercent}",
                "unit": "%",
                "thresholds": {
                  "warning": 75,
                  "danger": 90
                }
              }
            },
            {
              "type": "text",
              "text": "Load {data.cpu.loadAvg1} / {data.cpu.loadAvg5} / {data.cpu.loadAvg15}  ·  {data.cpu.temperature}°C  ·  swap {data.memory.swapUsedMB} MB"
            }
          ]
        }
      }
    }
  ]
}
