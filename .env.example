NODE_NAME=server-a
RQLITE_JOIN=
# Generate both with: openssl rand -base64 48
MASTER_KEY=change-me-to-a-32-plus-character-secret-key
AUTH_SECRET=change-me-to-a-random-jwt-signing-secret
