#!/command/with-contenv sh
# rqlite node. Single node by default. Cluster settings come from the UI
# (Settings > Cluster, stored in <data>/bosun/cluster.json and applied by
# cluster-boot.js) or from the environment (NODE_NAME, RQLITE_ADV_HOST,
# RQLITE_JOIN, RQLITE_BOOTSTRAP_EXPECT). See README "Clustering".
RQLITE_HTTP_PORT="${RQLITE_HTTP_PORT:-4001}"
RQLITE_RAFT_PORT="${RQLITE_RAFT_PORT:-4002}"
RQLITE_DATA_DIR="${RQLITE_DATA_DIR:-/data/rqlite}"
mkdir -p "${RQLITE_DATA_DIR}"

# Effective settings (UI file over env) and any pending one-shot action
# (re-address, force single, wipe and join). Defaults if the helper fails.
BOSUN_NODE_ID="${NODE_NAME:-node1}"
BOSUN_ADV_HOST="${RQLITE_ADV_HOST:-localhost}"
BOSUN_JOIN="${RQLITE_JOIN:-}"
BOSUN_EXPECT="${RQLITE_BOOTSTRAP_EXPECT:-}"
if [ -f /app/src/lib/cluster/boot.js ]; then
    BOOT_OUT="$(RQLITE_DATA_DIR="${RQLITE_DATA_DIR}" node /app/src/lib/cluster/boot.js)" && eval "${BOOT_OUT}"
fi

RQLITE_HTTP_ADV="${RQLITE_HTTP_ADV:-${BOSUN_ADV_HOST}:${RQLITE_HTTP_PORT}}"
RQLITE_RAFT_ADV="${RQLITE_RAFT_ADV:-${BOSUN_ADV_HOST}:${RQLITE_RAFT_PORT}}"

CLUSTER_FLAGS=""
if [ -n "${BOSUN_JOIN}" ]; then
    # Raft addresses of the other nodes (host:4002).
    CLUSTER_FLAGS="-join=${BOSUN_JOIN}"
    if [ -n "${BOSUN_EXPECT}" ]; then
        # All nodes start with the same join list and wait until this many are
        # up, then elect a leader together (no special "first" node).
        CLUSTER_FLAGS="${CLUSTER_FLAGS} -bootstrap-expect=${BOSUN_EXPECT}"
    fi
fi

# Disaster recovery via the environment (the UI offers the same as
# "Convert to single node"): the other nodes are permanently gone and this
# node must carry on alone. Applied once per data directory: a marker file
# stops a forgotten RQLITE_FORCE_SINGLE=1 from undoing a cluster rebuilt later.
FORCE_MARKER="${RQLITE_DATA_DIR}/.force-single-applied"
if [ "${RQLITE_FORCE_SINGLE}" = "1" ]; then
    if [ -f "${FORCE_MARKER}" ]; then
        echo "[rqlite] RQLITE_FORCE_SINGLE=1 ignored: recovery was already applied ($(cat "${FORCE_MARKER}")). Remove the variable."
    elif [ -d "${RQLITE_DATA_DIR}/raft" ]; then
        echo "[rqlite] RQLITE_FORCE_SINGLE=1: recovering as a single-node cluster (${BOSUN_NODE_ID} @ ${RQLITE_RAFT_ADV})"
        printf '[{"id":"%s","address":"%s","non_voter":false}]\n' "${BOSUN_NODE_ID}" "${RQLITE_RAFT_ADV}" > "${RQLITE_DATA_DIR}/raft/peers.json"
        date -u +%Y-%m-%dT%H:%M:%SZ > "${FORCE_MARKER}"
    fi
    CLUSTER_FLAGS=""
fi

echo "[rqlite] node ${BOSUN_NODE_ID} advertising ${RQLITE_RAFT_ADV}${CLUSTER_FLAGS:+ (${CLUSTER_FLAGS})}"
chown -R node:node "${RQLITE_DATA_DIR}"
exec s6-setuidgid node /usr/local/bin/rqlited \
    -node-id="${BOSUN_NODE_ID}" \
    -http-addr="0.0.0.0:${RQLITE_HTTP_PORT}" \
    -http-adv-addr="${RQLITE_HTTP_ADV}" \
    -raft-addr="0.0.0.0:${RQLITE_RAFT_PORT}" \
    -raft-adv-addr="${RQLITE_RAFT_ADV}" \
    ${CLUSTER_FLAGS} \
    "${RQLITE_DATA_DIR}"
