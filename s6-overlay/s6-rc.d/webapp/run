#!/command/with-contenv sh
RQLITE_URL="http://localhost:${RQLITE_HTTP_PORT:-4001}"
echo "[webapp] waiting for rqlite at ${RQLITE_URL}..."
until wget -q -O /dev/null "${RQLITE_URL}/readyz" 2>/dev/null; do
    sleep 1
done
cd /app
exec s6-setuidgid node ./node_modules/.bin/next start -p "${PORT:-3000}"
